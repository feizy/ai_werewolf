# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/werewolf
DB_HOST=localhost
DB_PORT=5432
DB_NAME=werewolf
DB_USER=username
DB_PASSWORD=password

# Redis配置
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AgentScope配置
AGENTSCOPE_API_KEY=your_agent_scope_api_key
AGENTSCOPE_BASE_URL=http://localhost:8080
AGENTSCOPE_TIMEOUT=30000

# WebSocket配置
WS_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000

# AI配置
OPENAI_API_KEY=your_openai_api_key
CLAUDE_API_KEY=your_claude_api_key
AI_DEFAULT_TIMEOUT=20000

# 游戏配置
GAME_DURATION_LIMIT=3600
MAX_CONCURRENT_GAMES=100
MAX_PLAYERS_PER_GAME=9
AI_RESPONSE_DELAY_MIN=500
AI_RESPONSE_DELAY_MAX=20000

# JWT配置
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# 安全配置
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# 开发配置
ENABLE_CORS=true
ENABLE_SWAGGER=true
ENABLE_PLAYGROUND=true