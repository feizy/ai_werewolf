# Environment configuration for werewolf backend

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/werewolf_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# AgentScope Configuration
AGENTSCOPE_API_KEY=your_agentscope_api_key_here
AGENTSCOPE_BASE_URL=https://api.agentscope.ai
AGENTSCOPE_MODEL=gpt-4

# OpenAI Configuration (for AI agents)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Anthropic Configuration (alternative AI provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WebSocket Configuration
WEBSOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WEBSOCKET_PING_TIMEOUT=60
WEBSOCKET_PING_INTERVAL=25

# Game Configuration
DEFAULT_MAX_PLAYERS=9
GAME_TIMEOUT_MINUTES=30
MIN_PLAYERS_TO_START=4

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/werewolf_backend.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Performance Configuration
MAX_WORKERS=4
KEEP_ALIVE=2
REQUEST_TIMEOUT=30

# Development/Testing
MOCK_AI_AGENTS=false
ENABLE_METRICS=true
ENABLE_PROFILING=false